{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["develop"],
  "labels": ["dependencies"],
  "prHourlyLimit": 2,
  "enabledManagers": ["npm", "pep621", "dockerfile", "docker-compose"],
  "packageRules": [
    {
      "managers": ["npm"],
      "paths": ["frontend/package.json"]
    },
    {
      "managers": ["pep621"],
      "packagePatterns": ["*"],
      "paths": ["backend/pyproject.toml"]
    },
    {
      "managers": ["dockerfile"],
      "paths": ["frontend/Dockerfile", "backend/Dockerfile"]
    },
    {
      "managers": ["docker-compose"],
      "paths": ["docker-compose.yml"]
    }
  ]
}
